# Local development settings for docker compose. Copy to .env: `cp .env.example .env`.
# These credentials exist only inside your local containers. Never reuse them anywhere else, and
# never commit .env (it is git-ignored). Production secrets come from a secrets manager.

# Schema owner (migrations only) and the application role (api, worker, riskosctl).
POSTGRES_PASSWORD=local-dev-only-postgres
POSTGRES_APP_PASSWORD=local-dev-only-postgres-app
REDIS_PASSWORD=local-dev-only-redis

# Keys the HMAC of stored API key secrets (at least 32 bytes). Changing it invalidates every key.
RISKOS_API_KEY_PEPPER=local-dev-only-api-key-pepper-0123456789

# Host ports (published on 127.0.0.1 only).
API_PORT=8080
FRONTEND_PORT=3000
POSTGRES_PORT=5432
REDIS_PORT=6379

# Backend settings. See backend/internal/platform/config/config.go for every RISKOS_* variable,
# its default and its validation rules.
RISKOS_LOG_LEVEL=info

# Request limits per API key and per tenant (sustained per second, and burst).
RISKOS_RATE_LIMIT_KEY_PER_SECOND=100
RISKOS_RATE_LIMIT_KEY_BURST=200
RISKOS_RATE_LIMIT_TENANT_PER_SECOND=500
RISKOS_RATE_LIMIT_TENANT_BURST=1000
RISKOS_OTEL_ENABLED=true

# Pseudonymizes customer identifiers before they reach Redis (at least 32 bytes). Changing it
# resets behavioral history (devices, beneficiaries, baselines).
RISKOS_FEATURE_HASH_KEY=local-dev-only-feature-hash-key-0123456789

# Derives every webhook endpoint's signing secret (at least 32 bytes). Changing it changes every
# endpoint's secret at once.
RISKOS_WEBHOOK_SIGNING_KEY=local-dev-only-webhook-signing-key-0123456789

# Keys console MFA secrets and CSRF tokens (at least 32 bytes). Rotating it invalidates enrolled
# authenticator apps.
RISKOS_CONSOLE_SECRET=local-dev-only-console-secret-0123456789abcd

# Self-serve sign-up: anyone can create a workspace from /signup. New workspaces are pinned to
# RISKOS_SIGNUP_REGION; production stays locked until staff approve their onboarding.
RISKOS_SIGNUP_ENABLED=true
RISKOS_SIGNUP_REGION=local-1
# Google sign-in (optional): an OAuth client of type "Web application" in Google Cloud Console,
# with the authorized redirect URI http://localhost:3000/signup/google. Set both or neither.
RISKOS_GOOGLE_CLIENT_ID=
RISKOS_GOOGLE_CLIENT_SECRET=
# Staff single sign-on (optional): the platform's identity provider for the /admin realm. Set all
# three or none; the redirect URI is <console URL>/admin/sso/callback. The passkey is still
# required after it. RISKOS_STAFF_SSO_REQUIRED=true refuses direct passkey sign-in.
RISKOS_STAFF_SSO_ISSUER=
RISKOS_STAFF_SSO_CLIENT_ID=
RISKOS_STAFF_SSO_CLIENT_SECRET=
RISKOS_STAFF_SSO_REQUIRED=false
