      "effective": {
        "text": "Money Laundering (Prevention and Prohibition) Act 2022; the library does not state the commencement date"
      },
      "verification": "conflicting",
      "caveat": "The Act says five years; some summaries say seven for certain records. Five is the minimum and can be raised.",
      "defaults": {
        "enabled": true,
        "mode": "live"
      },
      "inputs": [
        "workflow"
      ],
      "outcome": {
        "reason": "retention"
      },
