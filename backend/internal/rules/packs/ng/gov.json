        "type": "control",
        "uses": [
          "retain_for"
        ]
      },
      "parameters": [
        {
          "name": "retain_for",
          "label": "Shortest time records are kept after the transaction or relationship ends",
          "type": "duration",
          "default": 157680000,
          "min": 157680000,
          "max": 630720000
        }
      ]
    },
