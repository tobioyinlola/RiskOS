{
  "rules": [
    {
      "id": "VEL-01",
      "group": "velocity",
      "kind": "signal",
      "status": "recommended",
      "regulators": [
        "NIBSS"
      ],
      "sources": [
        "S7"
      ],
      "effective": {
        "text": "Not regulation: a recommended starting rule from the library of 2 October 2026"
      },
      "verification": "secondary_source_only",
      "defaults": {
        "enabled": true,
        "mode": "shadow"
      },
      "inputs": [
        "events",
        "history"
      ],
      "trigger": {
        "events": [
          "transfer_outbound"
        ]
      },
      "condition": {
        "left": {
          "agg": {
            "fn": "count",
            "event": "transfer_outbound",
            "window": "window",
            "by": "account"
          }
        },
        "op": "gte",
        "right": {
          "param": "transfers"
        }
      },
      "outcome": {
        "weight": "weight",
        "severity": "medium",
        "reason": "outbound_burst",
        "evidence": [
          "count"
        ]
      },
      "parameters": [
        {
          "name": "weight",
          "label": "Points added to the risk score",
          "type": "points",
          "default": 15,
          "min": 0,
          "max": 50
        },
        {
          "name": "transfers",
          "label": "Transfers out that count as a burst",
          "type": "count",
          "default": 5,
          "min": 2,
          "max": 100
        },
        {
          "name": "window",
          "label": "Time window",
          "type": "duration",
          "default": 600,
          "min": 60,
          "max": 3600
        }
      ]
    },
    {
      "id": "VEL-02",
      "group": "velocity",
      "kind": "signal",
      "status": "recommended",
      "regulators": [
        "NIBSS"
      ],
      "sources": [
        "S7"
      ],
      "effective": {
        "text": "Not regulation: a recommended starting rule from the library of 2 October 2026"
      },
      "verification": "secondary_source_only",
      "defaults": {
        "enabled": true,
        "mode": "shadow"
      },
      "inputs": [
        "events",
        "history"
      ],
      "trigger": {
        "events": [
          "transfer_outbound"
        ]
      },
      "condition": {
        "all": [
          {
            "left": {
              "agg": {
                "fn": "sum",
                "event": "transfer_outbound",
                "window": "window",
                "by": "account",
                "field": "txn.amount"
              }
            },
            "op": "gt",
            "right": {
              "times": {
                "factor": "multiple",
                "of": {
                  "agg": {
                    "fn": "daily_avg",
                    "event": "transfer_outbound",
                    "window": "baseline",
                    "by": "account",
                    "field": "txn.amount"
                  }
                }
              }
            }
          },
          {
            "left": {
              "agg": {
                "fn": "sum",
                "event": "transfer_outbound",
                "window": "window",
                "by": "account",
                "field": "txn.amount"
              }
            },
            "op": "gt",
            "right": {
              "param": "floor"
            }
          }
        ]
      },
      "outcome": {
        "weight": "weight",
        "severity": "medium",
        "reason": "value_spike",
        "evidence": [
          "sum_24h",
          "avg_30d"
        ]
      },
      "parameters": [
        {
          "name": "weight",
          "label": "Points added to the risk score",
          "type": "points",
          "default": 20,
          "min": 0,
          "max": 50
        },
        {
          "name": "multiple",
          "label": "How many times the usual daily amount",
          "type": "ratio",
          "default": 3,
          "min": 1.5,
          "max": 20
        },
        {
          "name": "window",
          "label": "Time window",
          "type": "duration",
          "default": 86400,
          "min": 3600,
          "max": 604800
        },
        {
          "name": "baseline",
          "label": "Period the usual daily amount is taken over",
          "type": "duration",
          "default": 2592000,
          "min": 604800,
          "max": 15552000
        },
        {
          "name": "floor",
          "label": "Smallest transfer the rule looks at (set by your institution)",
          "type": "money",
          "default": null,
          "min": 0,
          "max": 10000000000,
          "currency": "NGN"
        }
      ]
    },
    {
      "id": "VEL-03",
      "group": "velocity",
      "kind": "signal",
      "status": "recommended",
      "regulators": [
        "NIBSS"
      ],
      "sources": [
        "S7"
      ],
      "effective": {
        "text": "Not regulation: a recommended starting rule from the library of 2 October 2026"
      },
      "verification": "secondary_source_only",
      "defaults": {
        "enabled": true,
        "mode": "shadow"
      },
      "inputs": [
        "events",
        "history"
      ],
      "trigger": {
        "events": [
          "beneficiary_added"
        ]
      },
      "condition": {
        "left": {
          "agg": {
            "fn": "count",
            "event": "beneficiary_added",
            "window": "window",
            "by": "account",
            "where": {
              "left": {
                "fact": "beneficiary.is_new"
              },
              "op": "eq",
              "right": {
                "literal": true
              }
            }
          }
        },
        "op": "gte",
        "right": {
          "param": "payees"
        }
      },
      "outcome": {
        "weight": "weight",
        "severity": "medium",
        "reason": "beneficiary_burst"
      },
      "parameters": [
        {
          "name": "weight",
          "label": "Points added to the risk score",
          "type": "points",
          "default": 15,
          "min": 0,
          "max": 50
        },
        {
          "name": "payees",
          "label": "New payees that count as many",
          "type": "count",
          "default": 3,
          "min": 2,
          "max": 50
        },
        {
          "name": "window",
          "label": "Time window",
          "type": "duration",
          "default": 86400,
          "min": 3600,
          "max": 604800
        }
      ]
    },
    {
      "id": "VEL-04",
      "group": "velocity",
      "kind": "signal",
      "status": "recommended",
      "regulators": [
        "NIBSS"
      ],
      "sources": [
        "S7"
      ],
      "effective": {
        "text": "Not regulation: a recommended starting rule from the library of 2 October 2026"
      },
      "verification": "secondary_source_only",
      "defaults": {
        "enabled": true,
        "mode": "shadow"
      },
      "inputs": [
        "events",
        "history"
      ],
      "trigger": {
        "events": [
          "transfer_outbound",
          "transfer_inbound",
          "transfer_international",
          "cash_payment",
          "cash_withdrawal",
          "cash_deposit",
          "atm_withdrawal",
          "pos_purchase",
          "card_authorization",
          "crypto_purchase",
          "crypto_withdrawal",
          "crypto_transfer",
          "loan_disbursement",
          "loan_repayment"
        ]
      },
      "condition": {
        "any": [
          {
            "left": {
              "agg": {
                "fn": "count",
                "event": "transaction_any",
                "window": "window",
                "by": "account",
                "where": {
                  "all": [
                    {
                      "left": {
                        "fact": "txn.amount"
                      },
                      "op": "gte",
                      "right": {
                        "times": {
                          "factor": "band_low",
                          "of": {
                            "param": "new_device_cap"
                          }
                        }
                      }
                    },
                    {
                      "left": {
                        "fact": "txn.amount"
                      },
                      "op": "lte",
                      "right": {
                        "times": {
                          "factor": "band_high",
                          "of": {
                            "param": "new_device_cap"
                          }
                        }
                      }
                    }
                  ]
                }
              }
            },
            "op": "gte",
            "right": {
              "param": "transfers"
            }
          },
          {
            "left": {
              "agg": {
                "fn": "count",
                "event": "transaction_any",
                "window": "window",
                "by": "account",
                "where": {
                  "all": [
                    {
                      "left": {
                        "fact": "txn.amount"
                      },
                      "op": "gte",
                      "right": {
                        "times": {
                          "factor": "band_low",
                          "of": {
                            "param": "cash_ceiling"
                          }
                        }
                      }
                    },
                    {
                      "left": {
                        "fact": "txn.amount"
                      },
                      "op": "lte",
                      "right": {
                        "times": {
                          "factor": "band_high",
                          "of": {
                            "param": "cash_ceiling"
                          }
                        }
                      }
                    }
                  ]
                }
              }
            },
            "op": "gte",
            "right": {
              "param": "transfers"
            }
          },
          {
            "left": {
              "agg": {
                "fn": "count",
                "event": "transaction_any",
                "window": "window",
                "by": "account",
                "where": {
                  "all": [
                    {
                      "left": {
                        "fact": "txn.amount"
                      },
                      "op": "gte",
                      "right": {
                        "times": {
                          "factor": "band_low",
                          "of": {
                            "param": "atm_daily_limit"
                          }
                        }
                      }
                    },
                    {
                      "left": {
                        "fact": "txn.amount"
                      },
                      "op": "lte",
                      "right": {
                        "times": {
                          "factor": "band_high",
                          "of": {
                            "param": "atm_daily_limit"
                          }
                        }
                      }
                    }
                  ]
                }
              }
            },
            "op": "gte",
            "right": {
              "param": "transfers"
            }
          },
          {
            "left": {
              "agg": {
                "fn": "count",
                "event": "transaction_any",
                "window": "window",
                "by": "account",
                "where": {
                  "all": [
                    {
                      "left": {
                        "fact": "txn.amount"
                      },
                      "op": "gte",
                      "right": {
                        "times": {
                          "factor": "band_low",
                          "of": {
                            "param": "atm_weekly_limit"
                          }
                        }
                      }
                    },
                    {
                      "left": {
                        "fact": "txn.amount"
                      },
                      "op": "lte",
                      "right": {
                        "times": {
                          "factor": "band_high",
                          "of": {
                            "param": "atm_weekly_limit"
                          }
                        }
                      }
                    }
                  ]
                }
              }
            },
            "op": "gte",
            "right": {
              "param": "transfers"
            }
          }
        ]
      },
      "outcome": {
        "weight": "weight",
        "severity": "high",
        "reason": "structuring",
        "min_decision": "review",
        "evidence": [
          "limit_hit",
          "amounts"
        ]
      },
      "parameters": [
        {
          "name": "weight",
          "label": "Points added to the risk score",
          "type": "points",
          "default": 25,
          "min": 0,
          "max": 50
        },
        {
          "name": "transfers",
          "label": "Transfers just under a limit that count",
          "type": "count",
          "default": 3,
          "min": 2,
          "max": 50
        },
        {
          "name": "window",
          "label": "Time window",
          "type": "duration",
          "default": 86400,
          "min": 3600,
          "max": 604800
        },
        {
          "name": "band_low",
          "label": "Lower edge of 'just under' (share of the limit)",
          "type": "ratio",
          "default": 0.9,
          "min": 0.5,
          "max": 0.99
        },
        {
          "name": "band_high",
          "label": "Upper edge of 'just under' (share of the limit)",
          "type": "ratio",
          "default": 0.999,
          "min": 0.9,
          "max": 0.9999
        },
        {
          "name": "new_device_cap",
          "label": "₦20,000 new-device cap",
          "type": "money",
          "default": 2000000,
          "min": 0,
          "max": 2000000,
          "currency": "NGN"
        },
        {
          "name": "cash_ceiling",
          "label": "₦5m cash ceiling",
          "type": "money",
          "default": 500000000,
          "min": 0,
          "max": 500000000,
          "currency": "NGN"
        },
        {
          "name": "atm_daily_limit",
          "label": "₦100,000 daily ATM limit",
          "type": "money",
          "default": 10000000,
          "min": 0,
          "max": 10000000,
          "currency": "NGN"
        },
        {
          "name": "atm_weekly_limit",
          "label": "₦850,000 weekly ATM limit",
          "type": "money",
          "default": 85000000,
          "min": 0,
          "max": 85000000,
          "currency": "NGN"
        }
      ]
    },
    {
      "id": "VEL-05",
      "group": "velocity",
      "kind": "signal",
      "status": "recommended",
      "regulators": [
        "NIBSS"
      ],
      "sources": [
        "S7"
      ],
      "effective": {
        "text": "Not regulation: a recommended starting rule from the library of 2 October 2026"
      },
      "verification": "secondary_source_only",
      "defaults": {
        "enabled": true,
        "mode": "shadow"
      },
      "inputs": [
        "events",
        "history"
      ],
      "trigger": {
        "events": [
          "transfer_outbound"
        ]
      },
      "condition": {
        "left": {
          "agg": {
            "fn": "max_distinct_per_value",
            "event": "transfer_outbound",
            "window": "window",
            "by": "account",
            "field": "beneficiary.id",
            "per": "txn.amount",
            "where": {
              "left": {
                "fact": "txn.amount"
              },
              "op": "multiple_of",
              "right": {
                "param": "round_unit"
              }
            }
          }
        },
        "op": "gte",
        "right": {
          "param": "repeats"
        }
      },
      "outcome": {
        "weight": "weight",
        "severity": "low",
        "reason": "repeated_round_amounts"
      },
      "parameters": [
        {
          "name": "weight",
          "label": "Points added to the risk score",
          "type": "points",
          "default": 10,
          "min": 0,
          "max": 50
        },
        {
          "name": "repeats",
          "label": "Identical round amounts to different people",
          "type": "count",
          "default": 3,
          "min": 2,
          "max": 50
        },
        {
          "name": "window",
          "label": "Time window",
          "type": "duration",
          "default": 86400,
          "min": 3600,
          "max": 604800
        },
        {
          "name": "round_unit",
          "label": "What counts as round (a multiple of)",
          "type": "money",
          "default": 100000,
          "min": 100,
          "max": 100000000,
          "currency": "NGN"
        }
      ]
    },
    {
      "id": "VEL-06",
      "group": "velocity",
      "kind": "signal",
      "status": "recommended",
      "regulators": [
        "NIBSS"
      ],
      "sources": [
        "S7"
      ],
      "effective": {
        "text": "Not regulation: a recommended starting rule from the library of 2 October 2026"
      },
      "verification": "secondary_source_only",
      "defaults": {
        "enabled": true,
        "mode": "shadow"
      },
      "inputs": [
        "events",
        "history"
      ],
      "trigger": {
        "events": [
          "transfer_outbound"
        ]
      },
      "condition": {
        "all": [
          {
            "left": {
              "fact": "beneficiary.is_new"
            },
            "op": "eq",
            "right": {
              "literal": true
            }
          },
          {
            "left": {
              "fact": "txn.first_to_beneficiary"
            },
            "op": "eq",
            "right": {
              "literal": true
            }
          },
          {
            "left": {
              "fact": "txn.amount"
            },
            "op": "gt",
            "right": {
              "param": "high_value"
            }
          },
          {
            "left": {
              "fact": "txn.local_hour"
            },
            "op": "gte",
            "right": {
              "param": "night_start"
            }
          },
          {
            "left": {
              "fact": "txn.local_hour"
            },
            "op": "lt",
            "right": {
              "param": "night_end"
            }
          }
        ]
      },
      "outcome": {
        "weight": "weight",
        "severity": "medium",
        "reason": "night_first_payment"
      },
      "parameters": [
        {
          "name": "weight",
          "label": "Points added to the risk score",
          "type": "points",
          "default": 15,
          "min": 0,
          "max": 50
        },
        {
          "name": "high_value",
          "label": "High-value amount (set by your institution)",
          "type": "money",
          "default": null,
          "min": 0,
          "max": 100000000000,
          "currency": "NGN"
        },
        {
          "name": "night_start",
          "label": "Night starts (hour, Nigerian time)",
          "type": "hour",
          "default": 0,
          "min": 0,
          "max": 23
        },
        {
          "name": "night_end",
          "label": "Night ends (hour, Nigerian time)",
          "type": "hour",
          "default": 5,
          "min": 1,
          "max": 24
        }
      ]
    }
  ]
}
