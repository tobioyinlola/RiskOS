    {
      "id": "REG-17",
      "group": "mandatory_controls",
      "kind": "control",
      "status": "regulatory",
      "regulators": [
        "NFIU"
      ],
      "sources": [
        "S10"
      ],
      "effective": {
        "text": "In force 1 February 2026 (NFIU goAML upgrade)",
        "date": "2026-02-01"
      },
      "verification": "conflicting",
      "caveat": "The NFIU's goAML upgrade sets the report threshold at ₦5m (individual) and ₦10m (company) for domestic cash, but the 2022 Act treats those figures as cash-payment ceilings, not a reporting threshold. Both stay configurable.",
      "defaults": {
        "enabled": true,
        "mode": "live"
      },
      "inputs": [
        "events",
        "customer_profile"
      ],
      "trigger": {
        "events": [
          "cash_deposit",
          "cash_withdrawal",
          "cash_payment"
        ],
        "scope": {
          "left": {
            "fact": "txn.domestic"
          },
          "op": "eq",
          "right": {
            "literal": true
          }
        }
      },
      "condition": {
        "any": [
          {
            "all": [
              {
                "left": {
                  "fact": "customer.type"
                },
                "op": "eq",
                "right": {
                  "literal": "individual"
                }
              },
              {
                "left": {
                  "fact": "txn.amount"
                },
                "op": "gte",
                "right": {
                  "param": "ctr_individual"
                }
              }
            ]
          },
          {
            "all": [
              {
                "left": {
                  "fact": "customer.type"
                },
                "op": "eq",
                "right": {
                  "literal": "corporate"
                }
              },
              {
                "left": {
                  "fact": "txn.amount"
                },
                "op": "gte",
                "right": {
                  "param": "ctr_corporate"
                }
              }
            ]
          }
        ]
      },
      "outcome": {
        "reason": "currency_transaction_report",
        "tasks": [
          {
            "type": "report.CTR",
            "to": [
              "NFIU"
            ]
          }
        ],
        "evidence": [
          "txn.amount",
          "customer.type"
        ]
      },
      "parameters": [
        {
          "name": "ctr_individual",
          "label": "Domestic cash reported from, individual",
          "type": "money",
          "default": 500000000,
          "min": 0,
          "max": 500000000,
          "currency": "NGN"
        },
        {
          "name": "ctr_corporate",
          "label": "Domestic cash reported from, company",
          "type": "money",
          "default": 1000000000,
          "min": 0,
          "max": 1000000000,
          "currency": "NGN"
        }
      ]
    },
