    {
      "id": "REG-14",
      "group": "mandatory_controls",
      "kind": "control",
      "status": "regulatory",
      "regulators": [
        "NFIU",
        "law"
      ],
      "sources": [
        "S4",
        "S9"
      ],
      "effective": {
        "text": "NFIU suspicious transaction report guidelines of 18 December 2024",
        "date": "2024-12-18"
      },
      "verification": "conflicting",
      "caveat": "Timing differs by source: the NFIU guidelines say 72 hours to screen and 24 hours to file after suspicion is confirmed; summaries of the 2022 Act say 24 hours from the transaction; SEC material for virtual-asset providers mentions 48 hours. This rule follows the NFIU; confirm with counsel.",
      "defaults": {
        "enabled": true,
        "mode": "live"
      },
      "inputs": [
        "workflow"
      ],
      "trigger": {
        "events": [
          "alert_screening_due",
          "suspicion_confirmed"
        ]
      },
      "outcome": {
        "reason": "str_clocks",
        "tasks": [
          {
            "type": "escalate",
            "on": "alert_screening_due",
            "due": "screen_within",
            "to": [
              "compliance_officer"
            ]
          },
          {
            "type": "report.STR",
            "on": "suspicion_confirmed",
            "due": "str_due",
            "to": [
              "NFIU"
            ]
          }
        ]
      },
      "parameters": [
        {
          "name": "screen_within",
          "label": "Time to screen an alert before it is escalated",
          "type": "duration",
          "default": 259200,
          "min": 3600,
          "max": 259200
        },
        {
          "name": "str_due",
          "label": "Time to file after suspicion is confirmed",
          "type": "duration",
          "default": 86400,
          "min": 3600,
          "max": 86400
        }
      ]
    },
