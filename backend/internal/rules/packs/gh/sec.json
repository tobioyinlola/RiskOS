    {
      "id": "GH-SEC-02",
      "group": "cybersecurity",
      "kind": "signal",
      "status": "recommended",
      "provenance": "industry_practice",
      "lineage": {
        "kind": "param",
        "of": [
          "SEC-04"
        ]
      },
      "regulators": [
        "BoG"
      ],
      "sources": [
        "GS35"
      ],
      "effective": {
        "text": "Not regulation: a recommended starting rule from the Ghana and Rwanda library of 4 October 2026"
      },
      "verification": "secondary_source_only",
      "defaults": {
        "enabled": true,
        "mode": "shadow"
      },
      "inputs": [
        "events",
        "history"
      ],
      "trigger": {
        "events": [
          "mfa_prompt",
          "otp_used"
        ]
      },
      "condition": {
        "any": [
          {
            "left": {
              "agg": {
                "fn": "count",
                "event": "mfa_prompt",
                "window": "window",
                "by": "account",
                "where": {
                  "left": {
                    "fact": "mfa.channel"
                  },
                  "op": "in",
                  "right": {
                    "literal": [
                      "push",
                      "otp"
                    ]
                  }
                }
              }
            },
            "op": "gte",
            "right": {
              "param": "prompts"
            }
          },
          {
            "left": {
              "fact": "otp.device_mismatch"
            },
            "op": "eq",
            "right": {
              "literal": true
            }
          }
        ]
      },
      "outcome": {
        "weight": "weight",
        "severity": "high",
        "reason": "mfa_fatigue_or_otp_interception",
        "hints": [
          "pause_prompts",
          "alert"
        ]
      },
      "parameters": [
        {
          "name": "weight",
          "label": "Points added to the risk score",
          "type": "points",
          "default": 25,
          "min": 0,
          "max": 50
        },
        {
          "name": "prompts",
          "label": "Prompts to one user that count",
          "type": "count",
          "default": 5,
          "min": 2,
          "max": 100
        },
        {
          "name": "window",
          "label": "Time window",
          "type": "duration",
          "default": 600,
          "min": 60,
          "max": 3600
        }
      ]
    },
