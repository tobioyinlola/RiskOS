{
  "rules": [
    {
      "id": "GH-GOV-01",
      "group": "governance",
      "kind": "governance",
      "status": "governance",
      "provenance": "regulatory",
      "lineage": {
        "kind": "param",
        "of": [
          "GOV-08"
        ]
      },
      "template": {
        "pack": "ng",
        "rule": "GOV-08"
      },
      "overrides": {
        "retain_for": {
          "default": 157680000,
          "min": 157680000,
          "label": "Shortest time records are kept (5 years)"
        }
      },
      "regulators": [
        "FIC",
        "law"
      ],
      "sources": [
        "GS3",
        "GS24"
      ],
      "effective": {
        "text": "Anti-Money Laundering Act 2020 (Act 1044); in force, no amendment found; Act 987 for payment-platform audit logs"
      },
      "verification": "secondary_source_only",
      "caveat": "Act 1044 s.32 per summary; audit logs are kept 6 years under GH-SEC-11.",
      "defaults": {
        "enabled": true,
        "mode": "live"
      }
    },
    {
