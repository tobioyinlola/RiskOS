        "FIC"
      ],
      "sources": [
        "GS11"
      ],
      "effective": {
        "text": "Act 1044 reporting duties; the goAML channel is a vendor claim, unconfirmed"
      },
      "verification": "secondary_source_only",
      "caveat": "The reporting channel (goAML or another) is not confirmed for Ghana, so it is a setting of your institution.",
      "defaults": {
        "enabled": true,
        "mode": "live"
      }
    },
    {
      "id": "GH-GOV-04",
      "group": "governance",
      "kind": "governance",
      "status": "governance",
      "provenance": "regulatory",
      "lineage": {
        "kind": "new_local"
      },
      "regulators": [
        "BoG"
      ],
      "sources": [
        "GS2"
      ],
      "effective": {
        "text": "Bank of Ghana AML/CFT&P Guideline, December 2022; in force from issue"
      },
      "verification": "secondary_source_only",
      "defaults": {
        "enabled": true,
        "mode": "live"
      },
      "inputs": [
        "workflow"
      ],
      "outcome": {
        "reason": "periodic_review"
      },
      "governance": {
        "type": "job",
        "schedule": "daily",
        "uses": [
          "review_every"
        ]
      },
      "parameters": [
        {
          "name": "review_every",
          "label": "Longest time between reviews of an existing customer",
          "type": "duration",
          "default": 63072000,
          "min": 2592000,
          "max": 63072000
        }
      ]
    },
    {
      "id": "GH-GOV-05",
      "group": "governance",
      "kind": "governance",
      "status": "governance",
      "provenance": "regulatory",
      "lineage": {
        "kind": "new_local"
      },
      "regulators": [
        "BoG"
      ],
      "sources": [
        "GS2"
      ],
      "effective": {
        "text": "Bank of Ghana AML/CFT&P Guideline, December 2022; in force from issue"
      },
      "verification": "secondary_source_only",
      "defaults": {
        "enabled": true,
        "mode": "live"
      },
      "inputs": [
        "workflow"
      ],
      "outcome": {
        "reason": "testing_and_training"
      },
      "governance": {
        "type": "job",
        "schedule": "daily",
        "uses": [
          "test_every",
          "trainings_per_year"
        ]
      },
      "parameters": [
        {
          "name": "test_every",
          "label": "Longest time between tests of the AML system",
          "type": "duration",
          "default": 31536000,
          "min": 2592000,
          "max": 31536000
        },
        {
          "name": "trainings_per_year",
          "label": "Staff training sessions a year, at least",
          "type": "count",
          "default": 2,
          "min": 2,
          "max": 12
        }
      ]
    },
    {
      "id": "GH-GOV-06",
      "group": "governance",
      "kind": "governance",
      "status": "governance",
      "provenance": "regulatory",
