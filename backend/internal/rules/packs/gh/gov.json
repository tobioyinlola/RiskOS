          "GOV-05"
        ]
      },
      "regulators": [
        "FIC"
      ],
      "sources": [
        "GS7"
      ],
      "effective": {
        "text": "Executive Instrument 2 (per summary)"
      },
      "verification": "secondary_source_only",
      "caveat": "Quarterly reports and drills come from a summary of E.I. 2; confirm the recipient and format.",
      "defaults": {
        "enabled": true,
        "mode": "live"
      },
      "inputs": [
        "sanctions_list",
        "pep_list",
        "adverse_media"
      ],
      "outcome": {
        "reason": "continuous_screening"
      },
      "governance": {
        "type": "control",
        "uses": [
          "drill_every"
        ]
      },
      "parameters": [
        {
          "name": "drill_every",
          "label": "Time between sanctions reports and drills",
          "type": "duration",
          "default": 7776000,
          "min": 2592000,
          "max": 7776000
        }
      ]
    },
    {
      "id": "GH-GOV-07",
      "group": "governance",
      "kind": "governance",
