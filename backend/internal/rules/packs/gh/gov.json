    {
      "id": "GH-GOV-12",
      "group": "governance",
      "kind": "governance",
      "status": "governance",
      "provenance": "my_design",
      "lineage": {
        "kind": "param"
      },
      "regulators": [
        "FIC"
      ],
      "sources": [
        "GRLIB"
      ],
      "effective": {
        "text": "Not regulation: the library author's design (4 October 2026); numbers are starting values to calibrate in shadow mode"
      },
      "verification": "secondary_source_only",
      "defaults": {
        "enabled": true,
        "mode": "live"
      },
      "inputs": [
        "workflow"
      ],
      "outcome": {
        "reason": "internal_service_levels"
      },
      "governance": {
        "type": "sla",
        "uses": [
          "triage_within",
          "decide_within"
        ]
      },
      "parameters": [
        {
          "name": "triage_within",
          "label": "Time to triage a high-risk alert",
          "type": "duration",
          "default": 14400,
          "min": 3600,
          "max": 86400
        },
        {
          "name": "decide_within",
          "label": "Time to decide whether to file an STR",
          "type": "duration",
          "default": 43200,
          "min": 3600,
          "max": 86400
        }
      ]
    },
    {
      "id": "GH-GOV-13",
      "group": "governance",
      "kind": "governance",
      "status": "governance",
      "provenance": "my_design",
      "lineage": {
        "kind": "new_local"
      },
      "regulators": [
        "law"
      ],
      "sources": [
        "GS3",
        "GS5",
        "GS6",
        "GS24"
      ],
      "effective": {
        "text": "Fines (Penalty Units) Act 2000 (Act 572); penalty-unit value from a GRA page with no effective date"
      },
      "verification": "secondary_source_only",
      "caveat": "One penalty unit is GHS 12 per a Ghana Revenue Authority page whose effective date is unverified; cedi estimates are an inference.",
      "defaults": {
        "enabled": true,
        "mode": "live"
      },
      "inputs": [
        "workflow"
      ],
      "outcome": {
        "reason": "penalty_exposure"
      },
      "governance": {
        "type": "display",
        "uses": [
          "penalty_unit_value"
        ]
      },
      "parameters": [
        {
          "name": "penalty_unit_value",
          "label": "Value of one penalty unit (inference: GHS 12)",
          "type": "money",
          "default": 1200,
          "min": 100,
          "max": 100000,
          "currency": "GHS"
        }
      ]
    }
