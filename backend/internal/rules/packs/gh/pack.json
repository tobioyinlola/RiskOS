  "glossary": [
    {
      "term": "FIC",
      "expansion": "Financial Intelligence Centre",
      "definition": "Ghana's agency that receives suspicious transaction reports, cash reports and electronic transfer reports."
    },
    {
      "term": "BoG",
      "expansion": "Bank of Ghana",
      "definition": "Ghana's central bank, which licenses and supervises banks, payment institutions, e-money issuers and forex bureaux."
    },
    {
      "term": "CSA",
      "expansion": "Cyber Security Authority",
      "definition": "Ghana's cybersecurity regulator: it licenses security providers and receives incident reports from critical infrastructure owners."
    },
    {
      "term": "DPC",
      "expansion": "Data Protection Commission",
      "definition": "Ghana's data protection regulator, which registers data controllers and receives breach notices."
    },
    {
      "term": "GhIPSS",
      "expansion": "Ghana Interbank Payment and Settlement Systems",
      "definition": "The company that connects Ghana's banks and mobile-money networks so money can move between them."
    },
    {
      "term": "Ghana Card",
      "expansion": "",
      "definition": "Ghana's national identity card, issued by the National Identification Authority."
    },
    {
      "term": "NIA",
      "expansion": "National Identification Authority",
      "definition": "The body that issues the Ghana Card and verifies it."
    },
    {
      "term": "SDI",
      "expansion": "Specialised deposit-taking institution",
      "definition": "A licensed institution that takes deposits but is not a universal bank, such as a savings and loans company or a rural bank."
    },
    {
      "term": "CII",
      "expansion": "Critical information infrastructure",
      "definition": "Systems so important that the Cyber Security Authority designates them for stricter protection and faster incident reporting."
    },
    {
      "term": "CTR",
      "expansion": "Cash transaction report",
      "definition": "A report to the FIC of a large cash deposit, withdrawal or payment."
    },
    {
      "term": "ECTR",
      "expansion": "Electronic currency transaction report",
      "definition": "A report to the FIC of a cross-border transfer of US$1,000 or more."
    },
    {
      "term": "STR",
      "expansion": "Suspicious transaction report",
      "definition": "A report to the FIC about activity that may be linked to crime. Its existence must not be revealed to the customer."
    },
    {
      "term": "PEP",
      "expansion": "Politically exposed person",
      "definition": "Someone who holds or held an important public role, or their close family or associates."
    },
    {
      "term": "EDD",
      "expansion": "Enhanced due diligence",
      "definition": "Deeper checks for higher-risk customers, such as where their money and wealth come from, and approval by a senior manager."
    },
    {
      "term": "KYC",
      "expansion": "Know your customer",
      "definition": "The checks an institution makes to confirm who a customer is before and while serving them."
    },
    {
      "term": "Penalty unit",
      "expansion": "",
      "definition": "Ghana states fines in penalty units. One unit is GHS 12 according to a Ghana Revenue Authority page whose effective date is not stated."
    },
    {
      "term": "MoMo",
      "expansion": "Mobile money",
      "definition": "Money held in a mobile-phone wallet and moved by phone, through agents and between networks."
    },
    {
      "term": "Galamsey",
      "expansion": "",
      "definition": "Illegal small-scale gold mining in Ghana."
    },
    {
      "term": "TFS",
      "expansion": "Targeted financial sanctions",
      "definition": "Freezing the money of people and organisations named on sanctions lists, without warning them first."
    },
    {
      "term": "VASP",
      "expansion": "Virtual asset service provider",
      "definition": "A business that exchanges, holds or transfers crypto assets for customers."
    },
    {
      "term": "Structuring",
      "expansion": "",
      "definition": "Splitting money into several smaller amounts to stay under a limit or a reporting threshold."
    },
    {
      "term": "Mule account",
      "expansion": "",
      "definition": "An account used to receive and pass on stolen or criminal money, often owned by someone recruited or deceived."
    }
  ],
