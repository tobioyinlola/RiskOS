  "clocks": [
    {
      "id": "str_filing",
      "duration": "24 hours",
      "duty": "File a suspicious transaction report within 24 hours of forming suspicion (the BoG guideline says from confirmation)",
      "applies_to": "All accountable institutions (Act 1044 s.38)",
      "requirement": "Timer from the earliest recorded suspicion",
      "sources": [
        "GS2",
        "GS3"
      ],
      "rules": [
        "GH-REG-06"
      ],
      "hours": 24,
      "kind": "legal",
      "authority": "FIC"
    },
    {
      "id": "ctr_filing",
      "duration": "24 hours",
      "duty": "Report cash at or above GHS 50,000 (banks, securities) or GHS 20,000 (specialised deposit-taking institutions, forex bureaux)",
      "applies_to": "Accountable institutions (FIC report types)",
      "requirement": "Report draft with a deadline; the FIC page says \"filed daily\", so the deadline is configurable",
      "sources": [
        "GS1",
        "GS2",
        "GS9"
      ],
      "rules": [
        "GH-REG-04"
      ],
      "hours": 24,
      "kind": "legal",
      "authority": "FIC"
    },
    {
      "id": "ectr_filing",
      "duration": "24 hours",
      "duty": "Report cross-border transfers of US$1,000 or more within 24 hours after the transfer",
      "applies_to": "Commercial banks and other reporters (BoG guideline s.2.9.2)",
      "requirement": "Report draft with a deadline",
      "sources": [
        "GS1",
        "GS2"
      ],
      "rules": [
        "GH-REG-05"
      ],
      "hours": 24,
      "kind": "legal",
      "authority": "FIC"
    },
    {
      "id": "fic_suspension",
      "duration": "Up to 7 working days",
      "duty": "Hold a transaction the FIC suspends, then let the hold expire",
      "applies_to": "Any account or transaction in scope (Act 1044 s.45)",
      "requirement": "Hold with automatic expiry; RiskOS counts calendar time until working-day clocks arrive",
      "sources": [
        "GS3"
      ],
      "rules": [
        "GH-REG-11"
      ],
      "hours": 168,
      "kind": "legal",
      "authority": "FIC"
    },
    {
      "id": "sanctions_freeze",
      "duration": "24 hours (design placeholder)",
      "duty": "Freeze funds of a designated person without prior notice; E.I. 2 gives no hour count",
      "applies_to": "Accountable institutions (E.I. 2)",
      "requirement": "Case timer from the match",
      "sources": [
        "GS7"
      ],
      "rules": [
        "GH-REG-08"
      ],
      "hours": 24,
      "kind": "design_placeholder",
      "authority": "FIC"
    },
    {
      "id": "bog_payment_report",
      "duration": "10 days",
      "duty": "Report suspected or confirmed fraud, a security breach, a material service interruption or loss of confidential data",
      "applies_to": "Payment institutions (Act 987 s.42(5))",
      "requirement": "Incident record with a 10-day outer limit",
      "sources": [
        "GS24"
      ],
      "rules": [
        "GH-SEC-09"
      ],
      "hours": 240,
      "kind": "legal",
      "authority": "BoG"
    },
    {
      "id": "bog_cisd_2026",
      "duration": "Not found",
      "duty": "A faster incident clock may exist in the Bank of Ghana's 2026 cyber directive; its text was not found",
      "applies_to": "Institutions under the BoG cyber directive",
      "requirement": "Shown as not found until a person enters the directive's clock",
      "sources": [
        "GS25"
      ],
      "rules": [
        "GH-SEC-09"
      ],
      "hours": null,
      "kind": "not_found",
      "authority": "BoG"
    },
    {
      "id": "csa_incident",
      "duration": "24 hours",
      "duty": "Report a significant incident to the Cyber Security Authority within 24 hours of detection",
      "applies_to": "Designated critical information infrastructure owners",
      "requirement": "Incident record with a countdown from detection",
      "sources": [
        "GS18",
        "GS19"
      ],
      "rules": [
        "GH-SEC-08"
      ],
      "hours": 24,
      "kind": "legal",
      "authority": "CSA"
    },
    {
      "id": "csa_vulnerability",
      "duration": "72 hours",
      "duty": "Disclose a vulnerability to the Cyber Security Authority within 72 hours",
      "applies_to": "Designated critical information infrastructure owners",
      "requirement": "Second clock on the same record",
      "sources": [
        "GS18",
        "GS19"
      ],
      "rules": [
        "GH-SEC-08"
      ],
      "hours": 72,
      "kind": "legal",
      "authority": "CSA"
    },
    {
      "id": "dpc_breach",
      "duration": "72 hours (internal policy)",
      "duty": "Notify the Data Protection Commission and the people affected as soon as reasonably practicable; the Act has no hour count",
      "applies_to": "Data controllers (Act 843)",
      "requirement": "Breach workflow with an internal 72-hour target",
      "sources": [
        "GS26"
      ],
      "rules": [
        "GH-SEC-12"
      ],
      "hours": 72,
      "kind": "internal_policy",
      "authority": "DPC"
    },
    {
      "id": "outsourcing_sla",
      "duration": "10 days",
      "duty": "File the signed service agreement with the Bank of Ghana after signing",
      "applies_to": "Payment institutions (Act 987 s.38)",
      "requirement": "Task with a deadline",
      "sources": [
        "GS24"
      ],
      "rules": [
        "GH-SEC-10"
      ],
      "hours": 240,
      "kind": "legal",
