        "left": {
          "fact": "txn.amount_usd"
        },
        "op": "gte",
        "right": {
          "param": "edd_threshold"
        }
      },
      "outcome": {
        "decision": "review",
        "reason": "forex_high_value",
        "tasks": [
          {
            "type": "edd"
          },
          {
            "type": "biometric_verification"
          }
        ],
        "evidence": [
          "txn.amount_usd"
        ]
      },
      "parameters": [
        {
          "name": "edd_threshold",
          "label": "Forex deals needing enhanced checks and biometrics, from (US dollars)",
          "type": "money",
          "default": 1000000,
          "min": 0,
          "max": 1000000,
          "currency": "USD"
        }
      ]
    },
