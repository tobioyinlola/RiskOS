      "effective": {
        "text": "Law 60/2018 on cybercrimes, Arts 5-6 (per summary); in force"
      },
      "verification": "secondary_source_only",
      "caveat": "\"Immediately\" has no hour count, so the deadline is the moment of detection. Read from an aggregator or one secondary source, not the Gazette text; confirm the article numbers, amounts and dates against the original before relying on them.",
      "defaults": {
        "enabled": true,
        "mode": "live"
      },
      "inputs": [
        "events",
        "incident_register"
      ],
      "trigger": {
        "events": [
          "incident_detected"
        ]
      },
      "condition": {
