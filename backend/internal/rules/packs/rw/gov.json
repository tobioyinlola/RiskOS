          "name": "triage_within",
          "label": "Time to triage a high-risk alert",
          "type": "duration",
          "default": 14400,
          "min": 3600,
          "max": 86400
        },
        {
          "name": "decide_within",
          "label": "Time to decide whether to file an STR",
          "type": "duration",
          "default": 43200,
          "min": 3600,
          "max": 86400
