{
  "rules": [
    {
      "id": "RW-GOV-01",
      "group": "governance",
      "kind": "governance",
      "status": "governance",
      "provenance": "regulatory",
      "lineage": {
        "kind": "param",
        "of": [
          "GOV-08"
        ]
      },
      "template": {
        "pack": "ng",
        "rule": "GOV-08"
      },
      "overrides": {
        "retain_for": {
          "default": 315360000,
          "min": 315360000,
          "label": "Shortest time records are kept after the relationship ends (10 years)"
        }
      },
      "regulators": [
        "FIC",
        "law"
      ],
      "sources": [
        "RS2",
        "RS6"
      ],
      "effective": {
        "text": "Law No. 001/2025 of 22 January 2025 on money laundering, terrorism and proliferation financing; in force; records kept 10 years after the relationship ends (Art 21 per the ESAAMLG follow-up report)"
      },
      "verification": "conflicting",
      "caveat": "The 2024 mutual evaluation says 5 years under the old law (C3); the stricter 10 years is the default. Confirm in the Art 21 text.",
      "defaults": {
        "enabled": true,
        "mode": "live"
      }
    },
    {
