  "glossary": [
    {
      "term": "FIC",
      "expansion": "Financial Intelligence Centre",
      "definition": "Rwanda's agency that receives suspicious transaction reports and leads on targeted financial sanctions."
    },
    {
      "term": "BNR",
      "expansion": "National Bank of Rwanda",
      "definition": "Rwanda's central bank, which licenses and supervises banks, microfinance institutions, e-money issuers and payment service providers."
    },
    {
      "term": "RURA",
      "expansion": "Rwanda Utilities Regulatory Authority",
      "definition": "The regulator of telecom networks, including SIM registration and network security."
    },
    {
      "term": "CMA",
      "expansion": "Capital Market Authority",
      "definition": "The primary regulator of virtual-asset providers under Law 023/2026."
    },
    {
      "term": "NCSA",
      "expansion": "National Cyber Security Authority",
      "definition": "Rwanda's cybersecurity and data protection authority: it registers data controllers and receives breach notices."
    },
    {
      "term": "NIDA",
      "expansion": "National Identification Agency",
      "definition": "The agency that issues Rwandan national IDs and verifies them."
    },
    {
      "term": "eKash",
      "expansion": "",
      "definition": "Rwanda's national system for sending money between banks and mobile-money wallets, run by RSwitch."
    },
    {
      "term": "RSwitch",
      "expansion": "",
      "definition": "The company that runs Rwanda's national payment switch, including eKash."
    },
    {
      "term": "Rw-CSIRT",
      "expansion": "Rwanda Computer Security Incident Response Team",
      "definition": "The national team that receives and helps handle cyber incidents."
    },
    {
      "term": "TFS",
      "expansion": "Targeted financial sanctions",
      "definition": "Freezing the money of people and organisations named on sanctions lists, without warning them first. In Rwanda, within 24 hours."
    },
    {
      "term": "STR",
      "expansion": "Suspicious transaction report",
      "definition": "A report to the FIC about activity that may be linked to crime. Its existence must not be revealed to the customer."
    },
    {
      "term": "PEP",
      "expansion": "Politically exposed person",
      "definition": "Someone who holds or held an important public role, or their close family or associates."
    },
    {
      "term": "EDD",
      "expansion": "Enhanced due diligence",
      "definition": "Deeper checks for higher-risk customers, such as where their money and wealth come from, and approval by a senior manager."
    },
    {
      "term": "KYC",
      "expansion": "Know your customer",
      "definition": "The checks an institution makes to confirm who a customer is before and while serving them."
    },
    {
      "term": "Beneficial owner",
      "expansion": "",
      "definition": "The real person who owns or controls a company, even through other companies."
    },
    {
      "term": "SIM box",
      "expansion": "",
      "definition": "A device holding many SIM cards that routes international calls as local ones to avoid charges."
    },
    {
      "term": "VASP",
      "expansion": "Virtual asset service provider",
      "definition": "A business that exchanges, holds or transfers crypto assets for customers."
    },
    {
      "term": "Structuring",
      "expansion": "",
      "definition": "Splitting money into several smaller amounts to stay under a limit or a reporting threshold."
    },
    {
      "term": "Mule account",
      "expansion": "",
      "definition": "An account used to receive and pass on stolen or criminal money, often owned by someone recruited or deceived."
    }
  ],
  "penalties": [
    {
      "provision": "Targeted financial sanctions administrative fine (FIC Reg 001/FIC/2025 Arts 26-27)",
      "penalty": "RWF 1,000,000 to RWF 10,000,000",
      "sources": [
        "RS2"
      ]
    },
    {
      "provision": "Terrorism financing (Art 57(1)); non-compliance with preventive measures",
      "penalty": "20 to 25 years; 1 to 3 years",
      "sources": [
        "RS2"
      ]
    },
    {
      "provision": "Earlier regime (Laws 74 and 75/2019)",
      "penalty": "Up to 25 years; fines up to 20 times the financed illegal activity (superseded)",
      "sources": [
        "RS8"
      ]
    },
    {
      "provision": "Law 058/2021 administrative (Art 53)",
      "penalty": "RWF 2,000,000 to RWF 5,000,000 or 1% of global turnover; criminal up to 5% of annual turnover (Art 62); up to 10 years; cancellation of registration. ConsentStack lists a RWF 5,000,000 maximum: conflict",
      "sources": [
        "RS14"
      ]
    },
    {
      "provision": "Law 60/2018",
      "penalty": "Unauthorised access 6 months to 2 years and RWF 1 to 2 million; malware 2 to 5 years; critical infrastructure 10 to 15 years and RWF 10 to 30 million",
      "sources": [
        "RS15"
      ]
    },
    {
      "provision": "Law 023/2026",
      "penalty": "Unlicensed natural person RWF 30 to 50 million and 3 to 5 years; legal entity RWF 70 to 100 million; unlicensed issuance RWF 120 to 150 million; unapproved marketing RWF 15 to 20 million",
      "sources": [
        "RS13"
      ]
    },
    {
      "provision": "RURA Telecom Network Security Regulations",
      "penalty": "RWF 1 to 5 million; RWF 500,000 per day for delayed compliance; RWF 500,000 to 1 million for late incident information; RWF 200,000 to 1 million for late audit submissions",
      "sources": [
        "RS20"
      ]
    },
    {
      "provision": "RURA SIM draft",
      "penalty": "RWF 10,000,000 for illegal SIM swaps; RWF 2,500,000 per SIM for unauthorised use of subscriber data",
      "sources": [
        "RS21"
      ]
    },
    {
      "provision": "Foreign-currency pricing",
      "penalty": "RWF 5 million first offence; RWF 10 million repeat",
      "sources": [
        "RS27"
      ]
    },
    {
      "provision": "BNR Reg 50/2022 Art 25; Reg 54/2022 Art 44",
      "penalty": "Amounts not found",
      "sources": [
        "RS17",
        "RS11"
      ]
    }
  ],
